    {
      "id": "H3GHwFmR-yaQ380WtJOGU",
      "type": "text",
      "x": 270,
      "y": 757,
      "width": 458.38348388671875,
      "height": 120,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aX",
      "roundness": null,
      "seed": 989571968,
      "version": 292,
      "versionNonce": 1396796544,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790000011311,
      "link": null,
      "locked": false,
      "text": "Angular - Google thing, but open source, community driven.\n  - really \"opinionated\" (less than it used to be, but still...)\n        - \"Batteries Included\"\n  - Helped make TypeScript the thing it is today.\n - Needs a \"dev\" environment based on nodejs\n",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Angular - Google thing, but open source, community driven.\n  - really \"opinionated\" (less than it used to be, but still...)\n        - \"Batteries Included\"\n  - Helped make TypeScript the thing it is today.\n - Needs a \"dev\" environment based on nodejs\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "4YgryG7Pt5HNv6sFMaQbH",
      "type": "text",
      "x": 943,
      "y": 776,
      "width": 354.68768310546875,
      "height": 160,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aY",
      "roundness": null,
      "seed": 2138225792,
      "version": 211,
      "versionNonce": 1356373120,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790000078082,
      "link": null,
      "locked": false,
      "text": "React\n    - Easier to get started.\n    - Just as hard when you get big\n    - Batteries *NOT* included\n        - You get a lot of choice on things like\n             - routing\n            - state management\n            - API access",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "React\n    - Easier to get started.\n    - Just as hard when you get big\n    - Batteries *NOT* included\n        - You get a lot of choice on things like\n             - routing\n            - state management\n            - API access",
      "autoResize": true,
      "lineHeight": 1.25
    },
