      "isDeleted": false,
      "boundElements": null,
      "updated": 1790186801513,
      "link": null,
      "locked": false,
      "text": "Why did the browser have to get \"better\" as a platform for software?: STEVE JOBS KILLED FLASH\n- Macromedia Flash \n- Adobe bought flash - spent MILLIONS to turn it into the next big thing.\n    - a way to write applications that not only run in a browser, but can be installed\n      on ANY operating system.\n",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Why did the browser have to get \"better\" as a platform for software?: STEVE JOBS KILLED FLASH\n- Macromedia Flash \n- Adobe bought flash - spent MILLIONS to turn it into the next big thing.\n    - a way to write applications that not only run in a browser, but can be installed\n      on ANY operating system.\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
