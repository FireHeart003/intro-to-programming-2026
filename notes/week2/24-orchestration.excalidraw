      "boundElements": null,
      "updated": 1790361053518,
      "link": null,
      "locked": false,
      "text": "control plane\n    - X nodes that do the \nbusiness of the cluster.\n\n    - services\n        - dns\n        - etcd - backlog\n        - api - POST, DELETE, \n        - scheduler\n\nworker nodes\n    - all the other nodes in the cluster\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "control plane\n    - X nodes that do the \nbusiness of the cluster.\n\n    - services\n        - dns\n        - etcd - backlog\n        - api - POST, DELETE, \n        - scheduler\n\nworker nodes\n    - all the other nodes in the cluster\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
