      "boundElements": null,
      "updated": 1790360361294,
      "link": null,
      "locked": false,
      "text": "Amazon - Virtual Machines\n    - AKS\n   \nAzure - Virtual Machines\n    - AKS\n\n\nGoogle - GCP -\n    - \"The Borg\" -\n    - Go (golang) - \n    - Let's open source. (Kubernetes) \n    ",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Amazon - Virtual Machines\n    - AKS\n   \nAzure - Virtual Machines\n    - AKS\n\n\nGoogle - GCP -\n    - \"The Borg\" -\n    - Go (golang) - \n    - Let's open source. (Kubernetes) \n    ",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
