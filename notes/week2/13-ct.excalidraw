      "text": "Red is things that are always there while your app is running. They are \"singletons\"",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Red is things that are always there while your app is running. They are \"singletons\"",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "j3BLvZQFBNWyus7zoDlW2",
      "type": "text",
      "x": 517,
      "y": 156,
      "width": 904.8953857421875,
      "height": 20,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aJ",
      "roundness": null,
      "seed": 1448739688,
      "version": 116,
      "versionNonce": 1140599912,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790105943181,
      "link": null,
      "locked": false,
      "text": "Blue things are created for each request and thrown away at the end of the request. These are \"Scoped\" services.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Blue things are created for each request and thrown away at the end of the request. These are \"Scoped\" services.",
      "autoResize": true,
      "lineHeight": 1.25
    },
