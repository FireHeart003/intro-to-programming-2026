    {
      "id": "FHVctnUyhUjmnoNfwtrTX",
      "type": "text",
      "x": 696,
      "y": 608,
      "width": 184.79974365234375,
      "height": 40,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
