      "seed": 212887471,
      "version": 50,
      "versionNonce": 1803198415,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790259054449,
      "link": null,
      "locked": false,
      "text": "\"Vault\" - encrypted\n    - Hashicorp Vault",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\"Vault\" - encrypted\n    - Hashicorp Vault",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "OdK8YiZ6w0_yBjghZP0Ya",
      "type": "text",
      "x": 78,
      "y": 951,
      "width": 668.799072265625,
      "height": 160,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "ab",
      "roundness": null,
      "seed": 987832385,
      "version": 321,
      "versionNonce": 1755478081,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790259180773,
      "link": null,
      "locked": false,
      "text": "When we are running this angular app on our local machine it is *fake*.\nIt's not really the running application that will be delivered to the other \nenvironments.\n\nIt uses a development web server called \"Vite\".\nVite is commonly used by lots of frameworks - React, View, etc.\nIt is AWESOME.\n",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "When we are running this angular app on our local machine it is *fake*.\nIt's not really the running application that will be delivered to the other \nenvironments.\n\nIt uses a development web server called \"Vite\".\nVite is commonly used by lots of frameworks - React, View, etc.\nIt is AWESOME.\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "qvDzJUl2Fgz2JjRrl9znq",
      "type": "text",
      "x": 67,
      "y": 1126,
      "width": 923.9987182617188,
      "height": 60,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "ac",
      "roundness": null,
      "seed": 536802273,
      "version": 263,
      "versionNonce": 1632286497,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790259621115,
      "link": null,
      "locked": false,
      "text": "Vite allows \"HMR\" - \"Hot Module Replacement\"\n    - if you make a change in your app while you are doing development, it doesn't reload the whole thing\n      it just pushes (using a websocket) the new updated stuff, so you don't lose your state.",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Vite allows \"HMR\" - \"Hot Module Replacement\"\n    - if you make a change in your app while you are doing development, it doesn't reload the whole thing\n      it just pushes (using a websocket) the new updated stuff, so you don't lose your state.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "LvZZC-yZtc6dFM7FjVs5K",
      "type": "rectangle",
      "x": 155.43927510114736,
      "y": 540.7837865259772,
      "width": 46.25,
      "height": 28.75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "ad",
      "roundness": {
