    {
      "id": "OOcHP01Ny2evj4vNcqFaW",
      "type": "text",
      "x": 326,
      "y": 1518,
      "width": 913.9993896484375,
      "height": 150,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#228be6",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aW",
      "roundness": null,
      "seed": 741783683,
      "version": 381,
      "versionNonce": 582894211,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790099279792,
      "link": null,
      "locked": false,
      "text": "service workers are a browser standard\nThe allow you to load some javascript and have it run \"in the background\"\n    - it's a service - it's responsible for some data, and the stuff you can do with that data.\n\nBecause sw are used to sync data and stuff like that, they can look at every HTTP request\nyour app makes, and could even fulfill it itself.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "service workers are a browser standard\nThe allow you to load some javascript and have it run \"in the background\"\n    - it's a service - it's responsible for some data, and the stuff you can do with that data.\n\nBecause sw are used to sync data and stuff like that, they can look at every HTTP request\nyour app makes, and could even fulfill it itself.",
      "autoResize": true,
      "lineHeight": 1.25
    },
