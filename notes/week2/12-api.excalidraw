      "isDeleted": false,
      "boundElements": null,
      "updated": 1790098977981,
      "link": null,
      "locked": false,
      "text": "\"Late Bound\"\n    - the list of things in our \nparking lot is going to change\nfaster than our application does.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\"Late Bound\"\n    - the list of things in our \nparking lot is going to change\nfaster than our application does.",
      "autoResize": true,
      "lineHeight": 1.25
    },
