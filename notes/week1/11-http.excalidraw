      "isDeleted": false,
      "boundElements": null,
      "updated": 1789408290062,
      "link": null,
      "locked": false,
      "text": "multiple applications on a server*\ncan use TCP, but each have\nto have a unique \"port\"",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "multiple applications on a server*\ncan use TCP, but each have\nto have a unique \"port\"",
      "autoResize": true,
      "lineHeight": 1.25
    },
