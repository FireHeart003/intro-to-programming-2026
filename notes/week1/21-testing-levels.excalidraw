    {
      "id": "PjIqSRcCbt5X26FBqWrtX",
      "type": "text",
      "x": 721,
      "y": 179,
      "width": 775.1995849609375,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
