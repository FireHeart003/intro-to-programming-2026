      "seed": 609421197,
      "version": 111,
      "versionNonce": 149820685,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1789583269550,
      "link": null,
      "locked": false,
      "text": "Are \"Black Box\"* - They don't know *how* your code works, just what it does.\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Are \"Black Box\"* - They don't know *how* your code works, just what it does.\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "JGm2en_liL7zgIZtHqzvD",
