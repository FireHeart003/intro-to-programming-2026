    "@angular/router": "^22.1.0",
    "@hypertheory-labs/sanitize": "^0.4.1",
    "@hypertheory-labs/stellar-mcp": "^0.4.1",
    "@hypertheory-labs/stellar-ng-devtools": "^0.4.1",
