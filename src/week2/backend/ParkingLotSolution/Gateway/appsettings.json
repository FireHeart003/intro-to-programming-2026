{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Clusters": {
      "api": {
        "Destinations": {
          "destination1": {
      
            "Address": "https+http://parkinglot-api/"
          }
        }
      },
      "frontend": {
        "Destinations": {
          "destination1": {
            "Address": "https+http://frontend/"
          }
        }
      }

    },
    "Routes": {
      "api": {
        "ClusterId": "api",
        "Match": {
          "Path": "/api/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api"
          }
        ] 
      },
      "frontend": {
        "ClusterId": "frontend",
        "Match": {
          "Path": "/{**catch-all}"
        }
      }
    }
  }
}
